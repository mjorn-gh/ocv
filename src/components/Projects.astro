---
import { Image } from 'astro:assets';
import { getProjects } from '../lib/content';

const projects = await getProjects();
---

<section id="projects" class="section">
	<div class="heading">
		<h2>Projects</h2>
		<span class="mono">Selected work</span>
	</div>
	<ul class="grid">
		{
			projects.map(({ data }, i) => {
				const href = data.site ?? data.code;
				return (
					<li class="glass card">
						<Image src={data.image} alt="" width={720} class="image" />
						<div class="content">
							<div class="meta">
								<span class="mono">
									P.{String(i + 1).padStart(2, '0')} · {data.label}
								</span>
								{data.code && (
									<a href={data.code} class="mono code">
										Source ↗
									</a>
								)}
							</div>
							<h3>
								{href ? (
									<a href={href} class="link">
										{data.title} ↗
									</a>
								) : (
									data.title
								)}
							</h3>
							<p class="summary">{data.summary}</p>
							<span class="mono">{data.tags.join(' · ')}</span>
						</div>
					</li>
				);
			})
		}
	</ul>
</section>

<style>
	.section {
		display: flex;
		flex-wrap: wrap;
		gap: 32px;
		margin-top: 120px;
		scroll-margin-top: 24px;
	}

	.heading {
		flex: 0 0 220px;
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding-top: 8px;
	}

	h2 {
		font-size: 44px;
		font-weight: 700;
		letter-spacing: -0.03em;
		color: var(--strong);
	}

	.grid {
		flex: 1 1 600px;
		min-width: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border-radius: 20px;
		transition: translate 0.3s ease;
	}

	.card:has(.link:hover) {
		translate: 0 -4px;
	}

	.card :global(.image) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		border-bottom: 1px solid var(--glass-border);
	}

	.content {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 24px 28px 28px;
	}

	h3 {
		margin-top: 6px;
		font-size: 24px;
		font-weight: 600;
		line-height: 1.2;
		color: var(--strong);
	}

	/* Make the whole card clickable through the title link. */
	.link::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	.summary {
		flex: 1;
		font-size: 15px;
		line-height: 1.6;
		color: var(--muted);
	}

	.meta {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 16px;
	}

	/* Sits above the card-wide title link so it stays clickable on its own. */
	.code {
		position: relative;
		z-index: 1;
		padding: 6px 0;
		margin: -6px 0;
	}

	.code:hover {
		color: var(--text);
	}

	@media (max-width: 760px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 720px) {
		.section {
			margin-top: 80px;
			gap: 20px;
		}
		.heading {
			flex-basis: 100%;
		}
	}
</style>
